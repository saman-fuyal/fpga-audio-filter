## ---------------------------------------------------------------- configuration
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 33 [current_design]

## ---------------------------------------------------------------- I/O timing
## The whole design runs on the single 100 MHz clock. Every asynchronous input goes through
## a 2-flop synchronizer (sync2, ASYNC_REG) so it has no static-timing relationship with
## the clock; the outputs drive LEDs, displays, a 1 Mbaud UART and the 2.5 MHz microphone
## clock, all of which tolerate many ns of skew. These are therefore declared false paths
## instead of constraining them with fictitious board delays.
##
## M_DATA timing is guaranteed by design, not by STA: it is sampled ~150 ns after the M_CLK
## edge that launches it (half period 200 ns), see rtl/pdm_rx.v and paper Sec. IV-B.
set_false_path -from [get_ports {SW[*] BTNC CPU_RESETN M_DATA UART_TXD_IN}]
set_false_path -to   [get_ports {LED[*] LED16_R LED16_G LED17_B CA CB CC CD CE CF CG DP AN[*]}]
set_false_path -to   [get_ports {M_CLK M_LRSEL AUD_PWM AUD_SD UART_RXD_OUT}]
## (the M_CLK flop is packed into the I/O tile via an IOB attribute in rtl/pdm_rx.v)
