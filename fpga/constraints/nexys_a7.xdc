## Nexys A7-50T (also A7-100T) constraints for the real-time audio filter (top_nexys_a7)
## Pin lines copied verbatim from Digilent's official master file
## (github.com/Digilent/digilent-xdc, Nexys-A7-100T-Master.xdc). The 50T uses identical pins.

## ---------------------------------------------------------------- pins
set_property -dict { PACKAGE_PIN E3    IOSTANDARD LVCMOS33 } [get_ports { CLK100MHZ }]; #IO_L12P_T1_MRCC_35 Sch=clk100mhz
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports {CLK100MHZ}];
set_property -dict { PACKAGE_PIN J15   IOSTANDARD LVCMOS33 } [get_ports { SW[0] }]; #IO_L24N_T3_RS0_15 Sch=sw[0]
